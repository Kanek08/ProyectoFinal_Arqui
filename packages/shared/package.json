{
  "name": "@reservalab/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Esquemas Zod y tipos compartidos por api, web y cli",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
