# ---- Base de datos (desde tu máquina; docker compose sobreescribe el host a "postgres") ----
POSTGRES_USER=reservalab
POSTGRES_PASSWORD=reservalab
POSTGRES_DB=reservalab
# Puerto publicado en tu máquina. Cámbialo (p. ej. 5433) si ya tienes PostgreSQL instalado localmente.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reservalab:reservalab@localhost:5432/reservalab
DATABASE_URL_TEST=postgresql://reservalab:reservalab@localhost:5432/reservalab_test

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT (cambia estos valores; mínimo 32 caracteres) ----
JWT_ACCESS_SECRET=cambia-este-secreto-de-access-token-0123456789
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh-token-0123456789

# ---- Servicio externo de notificaciones (Mockoon) ----
NOTIFICATIONS_URL=http://localhost:3001

# ---- Caché y límite de solicitudes ----
CACHE_TTL_SECONDS=60
API_KEY_RATE_LIMIT_PER_MIN=60

# ---- API ----
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---- Web (Vite, se lee al compilar) ----
VITE_API_URL=http://localhost:3000/api/v1
